<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>PcDashApp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinRT>true</UseWinRT>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- PublishTrimmed disables classic COM activation by default (feature switch
         System.Runtime.InteropServices.BuiltInComInterop.IsSupported). NAudio's
         CoreAudioApi (MMDeviceEnumerator) is a classic COM coclass, not WinRT, and
         needs this on: without it, `new MMDeviceEnumerator()` throws
         NotSupportedException at runtime (confirmed on real Windows 2026-08-20). -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core Audio (volume/mute) readback. Windows.Media.Control (SMTC) needs no
         package: it comes from the windows10.x TFM + UseWinRT above. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
