<Window x:Class="PcDashApp.Logos.LogoPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change logo" Height="440" Width="420" MinHeight="380" MinWidth="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Border x:Name="PreviewHost" Width="48" Height="48" BorderBrush="#FFBBBBBB" BorderThickness="1" Margin="0,0,10,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ProjectNameText" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="Choose a generic icon, or upload a custom image." FontSize="11" Foreground="Gray"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Generic icons" FontWeight="SemiBold" Margin="0,4,0,4"/>
        <WrapPanel x:Name="GenericIconPanel" Grid.Row="2" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Text="Logo library (uploaded images)" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <WrapPanel x:Name="LibraryPanel"/>
        </ScrollViewer>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="UploadButton" Content="Upload new image..." Padding="8,4" Click="OnUploadClick"/>
            <CheckBox x:Name="InitialsOverlayCheck" Content="Initials overlay" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="14,4" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True"/>
            <Button Content="OK" Padding="14,4" Click="OnOkClick" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
